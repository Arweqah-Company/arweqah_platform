{
  "name": "@arweqah-platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "NODE_ENV=test npm run migration:run && vitest run --config vitest.e2e.config.mts",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "seed": "ts-node src/database/seeds/seed.ts",
    "seed:prod": "node dist/database/seeds/seed.js",
    "db:reset:test": "NODE_ENV=test npm run migration:run && NODE_ENV=test ts-node src/database/seeds/reset-test-db.ts"
  },
  "dependencies": {
    "@arweqah-platform/shared": "*",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@casl/ability": "7.0.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "11.2.7",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "better-auth": "1.7.7",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.5",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "xstate": "5.33.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arweqah-platform/eslint-config": "*",
    "@arweqah-platform/tsconfig": "*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
