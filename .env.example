# ---------- General ----------
NODE_ENV=development
PORT=3000
# Where people open the app, and the public API base (used in links and auth callbacks)
APP_URL=http://localhost:5173
API_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SWAGGER_ENABLED=true

# ---------- Database (PostgreSQL) ----------
# Local dev: 127.0.0.1. On the server: the RDS endpoint
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arweqah_platform
DB_USER=arweqah
DB_PASSWORD=change_me
DB_SSL=false

# ---------- Auth (Better Auth) ----------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Microsoft Entra ID (optional). TENANT_ID must be the company tenant GUID.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ---------- Field encryption (national IDs, bank data) ----------
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64_xxxxxxxxxxxx=

# ---------- Messaging ----------
# rabbitmq | memory (memory = no RabbitMQ, single process only)
MESSAGE_BUS=rabbitmq
RABBITMQ_URL=amqp://arweqah:change_me@127.0.0.1:5672

# ---------- Email (Mailpit locally, Amazon SES SMTP in production) ----------
MAIL_FROM=Arweqah Platform <no-reply@example.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------- Files ----------
# local | s3
FILE_STORAGE=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=me-south-1

# ---------- Seed (first admin) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_ADMIN_NAME=System Admin

# ---------- Web (baked into the build) ----------
VITE_API_URL=/api

# ---------- Production only (server .env) ----------
# REGISTRY=ghcr.io/arweqah-company
# IMAGE_PREFIX=arweqah-platform
# TAG=latest
