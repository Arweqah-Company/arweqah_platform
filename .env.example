# ---------- General ----------
NODE_ENV=development
PORT=3000
# Where people open the app, and the public API base (used in links and auth callbacks)
APP_URL=http://localhost:5173
API_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SWAGGER_ENABLED=true

# ---------- Database (PostgreSQL) ----------
# Local dev: 127.0.0.1. On the server: the RDS endpoint
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arweqah_platform
DB_USER=arweqah
DB_PASSWORD=change_me
DB_SSL=false

# ---------- Auth (Better Auth) ----------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Microsoft Entra ID (optional). TENANT_ID must be the company tenant GUID. Setup and check: docs/microsoft-sign-in.md, `npm run microsoft:check`.
# Redirect URI to register in Entra: <API_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# If the tenant blocks client secrets, leave the secret empty and use a certificate (scripts/generate-microsoft-certificate.sh):
# MICROSOFT_CERT_THUMBPRINT=
# MICROSOFT_CERT_PRIVATE_KEY_FILE=/path/to/arweqah-platform.key   (or MICROSOFT_CERT_PRIVATE_KEY with \n for line breaks)

# ---------- Field encryption (national IDs, bank data) ----------
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64_xxxxxxxxxxxx=
# Keyed hash for searching and de-duplicating encrypted ID numbers. Generate with: openssl rand -base64 48
BLIND_INDEX_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS_xxxxxxxxxxxxxxxx

# ---------- Messaging ----------
# rabbitmq | memory (memory = no RabbitMQ, single process only)
MESSAGE_BUS=rabbitmq
RABBITMQ_URL=amqp://arweqah:change_me@127.0.0.1:5672

# ---------- Email (Office 365 SMTP: smtp.office365.com, port 587, SMTP_SECURE=false = STARTTLS; SMTP AUTH must be on for the mailbox) ----------
# Locally you can point it at Mailpit instead (127.0.0.1:1025, no user). In production use Office 365 or Amazon SES.
MAIL_FROM=Arweqah Platform <no-reply@example.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------- Files ----------
# local | s3
FILE_STORAGE=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=me-south-1

# ---------- Seed (first admin) ----------
SEED_ADMIN_EMAIL=s.magdy@arweqah.sa
# Local development only (refused in production): base32 secret linking an authenticator app to the first admin.
# SEED_ADMIN_TOTP_SECRET=
# Development only (refused in production): fills every company with a small sample structure (units + job titles).
SEED_DEMO_ORG=true
# Sign-in attempts per minute and IP. Keep 5; only the browser tests raise it (refused above 10 in production).
# SIGN_IN_RATE_LIMIT=5
SEED_ADMIN_NAME=System Admin

# ---------- Web (baked into the build) ----------
VITE_API_URL=/api

# ---------- Production only (server .env; scripts/server/bootstrap.sh writes it) ----------
# APP_HOST=stg-portal.arweqah.sa   (web domain; nginx and the certificate use it; APP_URL / API_URL / CORS_ORIGINS use it too)
# API_HOST=stg-api-portal.arweqah.sa   (same API, reached directly)
# RABBITMQ_USER=arweqah
# RABBITMQ_PASSWORD=
# REGISTRY=ghcr.io/arweqah-company
# IMAGE_PREFIX=arweqah-platform
# TAG=latest
